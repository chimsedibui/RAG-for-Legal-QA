CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=replace-me
CHAT_MODEL_NAME=gpt-4.1-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL_NAME=text-embedding-3-small
# Dimension used when creating the FAISS index; does not shorten model output.
EMBEDDING_DIM=1536
DATA_DIR=data
PORT=8000
# Optional reranker: enable only when all three values are provided.
# RERANK_BASE_URL=http://reranker:8000/v1
# RERANK_API_KEY=unused
# RERANK_MODEL_NAME=your-reranker

# Optional: limits the scope of pipeline/crawl_preprocess.py. Unset = crawl all of vbpl.vn.
# CRAWL_DATE_FROM=2026-01-01
# CRAWL_DATE_TO=2026-06-01
# CRAWL_MAX_DOCS=500
# CRAWL_PAGE_SIZE=10
